(ns phosphene.sub
  "Spike: subpixel layouts. A terminal cell holds two colours, split top/bottom
  (▀) or left/right (▌); each half is one sub-element. A layout groups
  sub-elements into pixels and gives each one a channel, the way a display's
  R, G and B subpixels make up one pixel seen from a distance."
  (:require [math] [phosphene.fb :as fb]))

(def ESC fb/ESC)

;; :glyph decides how a cell splits; :grid gives the pixel grid for a cell
;; area; :at maps a sub-element (sx, sy) to [px py channel], where the
;; sub-element grid is cols × 2rows for ▀ and 2cols × rows for ▌.
;; Channels: 0 R, 1 G, 2 B, 3 W, 4 full colour (today's renderer).
(def layouts
  {"half"  {:glyph "▀" :grid (fn [c r] [c (* 2 r)]) :at (fn [sx sy] [sx sy 4])}
   "bayer" {:glyph "▀" :grid (fn [c r] [(quot c 2) r])
            ;; Two greens share G's share of the light (channel 5, half G).
            :at (fn [sx sy] [(quot sx 2) (quot sy 2)
                             (nth [0 5 5 2] (+ (mod sx 2) (* 2 (mod sy 2))))])}
   "rgbw"  {:glyph "▀" :grid (fn [c r] [(quot c 2) r])
            :at (fn [sx sy] [(quot sx 2) (quot sy 2)
                             (nth [0 1 2 3] (+ (mod sx 2) (* 2 (mod sy 2))))])}
   "lcd"   {:glyph "▌" :grid (fn [c r] [(quot (* 2 c) 3) r])
            :at (fn [sx sy] [(quot sx 3) sy (mod sx 3)])}
   "scan"  {:glyph "▀" :grid (fn [c r] [c (quot (* 2 r) 3)])
            :at (fn [sx sy] [sx (quot sy 3) (mod sy 3)])}})

(defn grid [mode cols rows] ((:grid (layouts mode)) cols rows))

(defn- colour
  "[r g b] in 0–255 for one sub-element showing channel ch of the pixel at i.
  bleed mixes in the pixel's full colour, so dark channels aren't black."
  [{:keys [r g b]} i ch gain bleed]
  (let [half? (= ch 5) ch (if half? 1 ch)
        pr (aget r i) pg (* (if half? 0.5 1.0) (aget g i)) pb (aget b i)
        gain (if (= ch 4) 1.0 gain) bleed (if (= ch 4) 1.0 bleed)
        v  (case ch 0 pr 1 pg 2 pb (/ (+ pr pg pb) 3.0))
        k  (- 1.0 bleed)
        e  (fn [c] (fb/c8 (* gain (+ (* k (if (or (= ch c) (= ch 3)) v 0.0))
                                     (* bleed (case c 0 pr 1 pg pb))))))]
    [(e 0) (e 1) (e 2)]))

(defn- sub-colour
  "Colour of sub-element (sx, sy), sampling the framebuffer nearest-neighbour
  from the layout's pixel grid."
  [{:keys [w h] :as f} at gw gh sx sy gain bleed]
  (let [[px py ch] (at sx sy)
        x (min (dec w) (int (* px (/ (double w) gw))))
        y (min (dec h) (int (* py (/ (double h) gh))))]
    (colour f (+ x (* y w)) ch gain bleed)))

(defn- cells
  "Calls (f col row [fg] [bg]) for every cell."
  [fbuf mode cols rows gain bleed f]
  (let [{:keys [glyph at]} (layouts mode)
        [gw gh] (grid mode cols rows)
        tb? (= glyph "▀")]
    (dotimes [row rows]
      (dotimes [col cols]
        (let [[ax ay bx by] (if tb?
                              [col (* 2 row) col (inc (* 2 row))]
                              [(* 2 col) row (inc (* 2 col)) row])]
          (f col row
             (sub-colour fbuf at gw gh ax ay gain bleed)
             (sub-colour fbuf at gw gh bx by gain bleed)))))))

(defn ansi
  "Like fb/ansi, through a subpixel layout."
  [fbuf mode cols rows top gain bleed]
  (let [sb (StringBuilder.) glyph (:glyph (layouts mode))]
    (.append sb (str ESC "[?2026h"))
    (cells fbuf mode cols rows gain bleed
           (fn [col row [fr fg fb] [br bg bb]]
             (when (zero? col) (.append sb (str ESC "[" (+ top row) ";1H")))
             (.append sb (str ESC "[38;2;" fr ";" fg ";" fb "m"
                              ESC "[48;2;" br ";" bg ";" bb "m" glyph))))
    (.append sb (str ESC "[0m" ESC "[?2026l"))
    (.toString sb)))

(defn preview-ppm
  "A simulated screenshot (P3): each cell drawn cw×ch pixels with its glyph's
  split, for judging layouts without a terminal."
  [fbuf mode cols rows gain bleed cw ch]
  (let [tb? (= "▀" (:glyph (layouts mode)))
        W (* cols cw) H (* rows ch)
        px (int-array (* 3 W H))]
    (cells fbuf mode cols rows gain bleed
           (fn [col row fc bc]
             (dotimes [yy ch]
               (dotimes [xx cw]
                 (let [[cr cg cb] (if (if tb? (< yy (quot ch 2)) (< xx (quot cw 2))) fc bc)
                       i (* 3 (+ (+ (* col cw) xx) (* W (+ (* row ch) yy))))]
                   (aset px i cr) (aset px (+ i 1) cg) (aset px (+ i 2) cb))))))
    (let [sb (StringBuilder.)]
      (.append sb (str "P3\n" W " " H "\n255\n"))
      (dotimes [i (* W H)]
        (.append sb (str (aget px (* 3 i)) " " (aget px (+ 1 (* 3 i))) " " (aget px (+ 2 (* 3 i))) "\n")))
      (.toString sb))))
