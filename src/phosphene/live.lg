(ns phosphene.live
  "Live input: mono s16le PCM at audio/SR read from a localhost TCP socket.
  lg has no way to spawn a process and read its stdout while it runs (os/sh
  and os/exec* block until exit), and stdin belongs to the key reader, so
  the source is a socket: --mic starts ffmpeg as the server, --pcm attaches
  to any other one."
  (:require [string] [math] [os] [net]
            [phosphene.audio :as audio] [phosphene.fft :as fft]
            [phosphene.listen :as listen]))

(def ^:private RING (* 4 audio/SR))
(def ^:private HOP (quot audio/SR audio/FPS-HOP))

;; Mic levels vary by tens of dB across rooms and devices, so the hop rms is
;; normalised against a slow peak to sit where a mastered track does (hop
;; rms p99 ≈ 0.4, p90 ≈ 0.22 for Sodium / UV, as of 2026-10-11). The gain
;; cap keeps a quiet room's hiss from being pumped up to full scale.
(def ^:private TARGET 0.3)
(def ^:private MAX-GAIN 30.0)
(def ^:private PEAK-RELEASE-S 10.0)
(def ^:private STALL-MS 1000)
;; A mic's noise floor sits far above this; only digital zeros fall below,
;; which is what a denied mic permission delivers instead of an error.
(def ^:private SILENT 1e-6)

;; The first --mic run from a new terminal waits on macOS's permission
;; prompt before ffmpeg starts listening, so the dial waits that long too.
;; ffmpeg's own listen timeout is longer, and ends it if phosphene dies first.
(def ^:private MIC-WAIT-S 60)
(def ^:private PCM-WAIT-S 5)

(defn initial-state []
  {:pos 0 :lp 0.0 :prev 0.0 :avg 0.0 :since 100
   :peak (/ TARGET MAX-GAIN)
   :rms 0.0 :gate 1.0 :flat 0.0
   :blocks [] :bmin 1e9 :bmax 0.0 :bn 0})

(defn start-mic
  "Starts ffmpeg capturing avfoundation audio device dev (an index or name;
  \"default\" is the system input) as a PCM server on port. Returns
  [pid log-path]; ffmpeg's stderr goes to the log."
  [dev port]
  (let [log (str (os/temp-dir) "/phosphene-mic-" port ".log")
        cmd (str "ffmpeg -nostdin -v error -f avfoundation -i " (audio/shq (str ":" dev))
                 " -ac 1 -ar " audio/SR " -f s16le "
                 (audio/shq (str "tcp://127.0.0.1:" port "?listen=1&listen_timeout="
                                 (* 1000 (+ MIC-WAIT-S 5))))
                 " >/dev/null 2>" (audio/shq log) " & echo $!")]
    [(string/trim (:out (os/sh "sh" "-c" cmd))) log]))

(defn running? [pid] (zero? (:exit (os/sh "kill" "-0" pid))))

(defn- feed!
  "Appends the little-endian int16 samples in byte-array b to the ring.
  lo is the low byte of a sample split across reads, or -1; returns the
  same for the next read."
  [^doubles ring head b lo]
  (let [n (count b)]
    (loop [i 0 lo lo h @head]
      (if (< i n)
        (let [x (bit-and (aget b i) 0xff)]
          (if (neg? lo)
            (recur (inc i) x h)
            (let [v (+ lo (* 256 x))]
              (aset ring (mod h RING) (/ (double (if (> v 32767) (- v 65536) v)) 32768.0))
              (recur (inc i) -1 (inc h)))))
        (do (reset! head h) lo)))))

(defn connect
  "Dials the PCM server on port, retrying while it starts up, and reads it
  into a ring buffer on a future. With a server pid (--mic), waits as long
  as that process is alive, up to MIC-WAIT-S. Returns the source for poll!."
  [port pid]
  (let [tries (* 10 (if pid MIC-WAIT-S PCM-WAIT-S))
        conn  (loop [i 0]
                (or (try (net/dial "127.0.0.1" port) (catch e nil))
                    (when (and (< i tries) (or (nil? pid) (running? pid)))
                      (sleep 100) (recur (inc i)))))]
    (when-not conn
      (throw (ex-info (str "no PCM server on port " port) {})))
    (let [ring (double-array RING) head (atom 0) closed (atom false)]
      (future
        (try
          (loop [lo -1]
            (when-let [b (net/read! conn 4096)]
              (recur (feed! ring head b lo))))
          (catch e nil))
        (reset! closed true))
      {:conn conn :ring ring :head head :closed closed
       :window (double-array fft/N)
       :st (atom (assoc (initial-state) :seen 0 :seen-ms (System/currentTimeMillis)
                        :sound-ms (System/currentTimeMillis)))})))

(defn disconnect! [src] (try (net/close! (:conn src)) (catch e nil)))

(defn- hop-levels
  "Kernel: [rms bass-rms lp'] over samples [s0, s0+HOP) of buf, read modulo
  len (RING for the ring), with the 150 Hz one-pole that audio/analyze uses
  for bass."
  [^doubles buf s0 ^double lp ^double k len]
  (loop [i 0 lp lp sa 0.0 sb 0.0]
    (if (< i HOP)
      (let [x (aget buf (mod (+ s0 i) len)) lp (+ lp (* k (- x lp)))]
        (recur (inc i) lp (+ sa (* x x)) (+ sb (* lp lp))))
      [(math/sqrt (/ sa HOP)) (math/sqrt (/ sb HOP)) lp])))

(def ^:private k-bass (- 1.0 (math/exp (/ (* -2.0 math/PI 150.0) audio/SR))))
(def ^:private k-peak (math/exp (/ (- (/ (double HOP) audio/SR)) PEAK-RELEASE-S)))

;; Noise gate. Mic self-noise is steady and spectrally flat; music, tones
;; and drones are peaky or move. Gating on both keeps hat-heavy passages,
;; which can look flat, open. Measured 2026-10-17 with numpy over 60 s of
;; each signal (white, pink, and band-limited pink noise; tone; drone;
;; Sodium / UV, plain and through a 200 Hz high-pass):
;;   flatness, 65 Hz–8 kHz   noise p10 ≥ 0.25; tones, drones, music p90 ≤ 0.08
;;   dynamics (see below)    noise p95 ≤ 2.5;  music p5 ≥ 17
(def ^:private FLAT-NOISE 0.15)
(def ^:private DYN-MUSIC 8.0)
(def ^:private GATE-BLOCK 30)   ; hops per dynamics block (0.5 s)
(def ^:private GATE-BLOCKS 20)  ; blocks in the window (10 s)
(def ^:private k-gate (- 1.0 (math/exp (/ (- (/ (double HOP) audio/SR)) 0.3))))

(defn- dynamics
  "The median block's loudest hop over the quietest hop in the window. The
  median, not the loudest, so one cough or door in a quiet room doesn't
  hold the gate open for the whole window; music has a hit in most blocks."
  [{:keys [blocks bmin bmax bn]}]
  (let [bs (if (pos? bn) (conj blocks [bmin bmax]) blocks)]
    (if (seq bs)
      (let [mx (vec (sort (map second bs)))]
        (/ (nth mx (quot (count mx) 2)) (max 1e-9 (reduce min (map first bs)))))
      0.0)))

(defn hop-step
  "Advances the per-hop state s by one hop with levels ra (full band) and rb
  (bass). Returns [s' hit?]. Pure, so it runs over a decoded track too."
  [s ra rb]
  (let [peak  (max ra (* k-peak (:peak s)))
        bn    (inc (:bn s))
        s     (assoc s :bmin (min (:bmin s) ra) :bmax (max (:bmax s) ra) :bn bn)
        s     (if (< bn GATE-BLOCK) s
                  (assoc s :blocks (vec (take-last GATE-BLOCKS (conj (:blocks s) [(:bmin s) (:bmax s)])))
                           :bmin 1e9 :bmax 0.0 :bn 0))
        noise? (and (> (:flat s) FLAT-NOISE) (< (dynamics s) DYN-MUSIC))
        gate  (+ (:gate s) (* k-gate (- (if noise? 0.0 1.0) (:gate s))))
        ;; Fully closed reads as silence, so listen's relative levels settle.
        gv    (if (< gate 0.01) 0.0 gate)
        g0    (min MAX-GAIN (/ TARGET (max peak 1e-6)))
        g     (* gv g0)
        ;; Onsets run on the ungated level, so the gate's own fade can't
        ;; read as a rise; the gate only decides whether a hit counts.
        b     (* g0 rb)
        hit?  (and (audio/onset? b (:prev s) (:avg s) (:since s)) (> gv 0.5))]
    [(assoc s :prev b :avg (audio/onset-avg (:avg s) b)
              :since (if hit? 0 (inc (:since s)))
              :peak peak :gate gate :gain g :rms (* g ra))
     hit?]))

(defn onsets
  "Hop indices where live detection fires over a whole decoded track, with
  the gate held open. For tuning and tests."
  [^doubles samples]
  (let [n (quot (alength samples) HOP)]
    (loop [f 0 lp 0.0 s (initial-state) acc []]
      (if (< f n)
        (let [[ra rb lp] (hop-levels samples (* f HOP) lp k-bass (alength samples))
              [s hit?] (hop-step s ra rb)]
          (recur (inc f) lp s (if hit? (conj acc f) acc)))
        acc))))

(defn poll!
  "Runs onset detection over the hops that arrived since the last call and
  fills the window with the latest fft/N samples, gain-normalised. Returns
  {:window :beat? :rms :level :stalled}."
  [{:keys [ring head closed window st]}]
  (let [h   @head
        s   @st
        ;; After a stall (a paused terminal, a slow frame) skip to the last
        ;; second rather than replaying old hops as a burst of beats.
        pos (max (:pos s) (- h audio/SR))
        now (System/currentTimeMillis)
        [s beat?]
        (loop [pos pos s s beat? false]
          (if (<= (+ pos HOP) h)
            (let [[ra rb lp] (hop-levels ring pos (:lp s) k-bass RING)
                  [s hit?] (hop-step (assoc s :lp lp) ra rb)]
              (recur (+ pos HOP)
                     (assoc s :pos (+ pos HOP) :sound-ms (if (> ra SILENT) now (:sound-ms s)))
                     (or beat? hit?)))
            [s beat?]))
        s   (if (not= h (:seen s)) (assoc s :seen h :seen-ms now) s)
        ;; With no new samples the ring holds the last sound forever, so a
        ;; lost source reads as silence rather than a frozen picture.
        lost (or @closed (> (- now (:seen-ms s)) STALL-MS))
        g   (if lost 0.0 (or (:gain s) MAX-GAIN))
        rms (if lost 0.0 (:rms s))
        n   (alength window)]
    (dotimes [i n]
      (let [j (+ (- h n) i)]
        (aset window i (if (neg? j) 0.0 (* g (aget ring (mod j RING)))))))
    (reset! st s)
    {:window window :beat? beat? :rms rms :gain g
     :level (/ rms TARGET)
     :stalled (or lost (> (- now (:sound-ms s)) STALL-MS))}))

(def ^:private flat-bins
  (let [hz (/ (double audio/SR) fft/N)]
    ;; Round up, so mains hum at 50 Hz stays below the first bin (65 Hz).
    [(int (math/ceil (/ 60.0 hz))) (min (quot fft/N 2) (int (/ 8000.0 hz)))]))

(defn flatness
  "Spectral flatness (geometric over arithmetic mean of power) of
  magnitudes mags over 65 Hz–8 kHz: near 0 for tones, ~0.5 for white noise."
  [^doubles mags]
  (let [[b0 b1] flat-bins n (- b1 b0)]
    (loop [k b0 sl 0.0 sp 0.0]
      (if (< k b1)
        (let [p (+ 1e-20 (* (aget mags k) (aget mags k)))]
          (recur (inc k) (+ sl (math/log p)) (+ sp p)))
        (/ (math/exp (/ sl n)) (max 1e-20 (/ sp n)))))))

(defn- raw-window
  "The latest fft/N ring samples, ungained."
  [{:keys [ring head]}]
  (let [h @head out (double-array fft/N)]
    (dotimes [i fft/N]
      (let [j (+ (- h fft/N) i)] (aset out i (if (neg? j) 0.0 (aget ring (mod j RING))))))
    out))

(defn frame
  "listen features from the latest live audio, at wall-clock time t. The
  window's flatness feeds the next poll's noise gate. Flatness ignores
  scale, so listen's spectrum serves while the gain is above zero; a closed
  gate zeroes the window, so then it takes its own FFT of the raw samples.
  Flatness drops at once and rises over ~1 s, so one peaky frame keeps the
  gate open through the noisy gaps between sparse hits."
  [st src t dt]
  (let [{:keys [window beat? rms level stalled gain]} (poll! src)
        f (listen/features st window (alength window) t dt beat? rms)
        mags (if (pos? gain) (:spectrum f) (fft/magnitudes (raw-window src) fft/N))
        now (flatness mags)]
    (swap! (:st src) update :flat
           (fn [prev] (if (< now prev) now (+ prev (* (- 1.0 (math/exp (- dt))) (- now prev))))))
    (assoc f :level level :stalled stalled)))
