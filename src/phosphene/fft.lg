(ns phosphene.fft
  (:require [math]))

(defn fft!
  "In-place radix-2 FFT over re/im double-arrays of power-of-two length n."
  [re im n]
  (loop [i 1 j 0]
    (when (< i n)
      (let [j (loop [bit (bit-shift-right n 1) j j]
                (if (pos? (bit-and j bit))
                  (recur (bit-shift-right bit 1) (bit-xor j bit))
                  (bit-or j bit)))]
        (when (< i j)
          (let [tr (aget re i) ti (aget im i)]
            (aset re i (aget re j)) (aset im i (aget im j))
            (aset re j tr) (aset im j ti)))
        (recur (inc i) j))))
  (loop [len 2]
    (when (<= len n)
      (let [ang (/ (* -2.0 math/PI) len) wr (math/cos ang) wi (math/sin ang) half (quot len 2)]
        (loop [i 0]
          (when (< i n)
            (loop [k 0 cr 1.0 ci 0.0]
              (when (< k half)
                (let [a (+ i k) b (+ a half)
                      br (aget re b) bi (aget im b)
                      xr (- (* br cr) (* bi ci))
                      xi (+ (* br ci) (* bi cr))
                      ar (aget re a) ai (aget im a)]
                  (aset re b (- ar xr)) (aset im b (- ai xi))
                  (aset re a (+ ar xr)) (aset im a (+ ai xi))
                  (recur (inc k) (- (* cr wr) (* ci wi)) (+ (* cr wi) (* ci wr))))))
            (recur (+ i len)))))
      (recur (* len 2)))))

(def N 1024)
(def ^:private window
  (let [w (double-array N)]
    (dotimes [i N] (aset w i (- 0.5 (* 0.5 (math/cos (/ (* 2.0 math/PI i) (dec N)))))))
    w))
(def ^:private re (double-array N))
(def ^:private im (double-array N))

(defn magnitudes
  "Hann-windowed magnitude spectrum (N/2 bins) of samples ending at index end."
  [samples end]
  (let [n (alength samples) s0 (- end N) out (double-array (quot N 2))]
    (dotimes [i N]
      (let [j (+ s0 i)]
        (aset re i (if (and (>= j 0) (< j n)) (* (aget samples j) (aget window i)) 0.0))
        (aset im i 0.0)))
    (fft! re im N)
    (dotimes [k (quot N 2)]
      (let [r (aget re k) m (aget im k)]
        (aset out k (/ (math/sqrt (+ (* r r) (* m m))) (* 0.25 N)))))
    out))
