(ns phosphene.main
  (:require [string] [math] [os] [term]
            [phosphene.audio :as audio]
            [phosphene.live :as live]
            [phosphene.listen :as listen]
            [phosphene.fb :as fb]
            [phosphene.director :as dir]))

(def ESC fb/ESC)

(defn- shq [s] (str "'" (string/replace s "'" "'\\''") "'"))
(defn- now-ms [] (System/currentTimeMillis))
(defn- basename [p] (last (string/split p "/")))

(defn- usage []
  (println "usage: phosphene <audio-file> [--fx NAME [--preset N]] [--fps N] [--scale N] [--mute] [--no-post]")
  (println "       phosphene --mic [DEVICE] [--fx NAME [--preset N]] [--fps N] [--scale N] [--no-post]")
  (println "       phosphene --pcm PORT [...]   s16le mono 22050 Hz from a TCP server on localhost")
  (println "       phosphene <audio-file> --dump SECONDS OUT.ppm [--size WxH] [--warm S] [--fx NAME]")
  (println "       phosphene <audio-file> --frames START SECONDS OUT-DIR [--size WxH] [--warm S]")
  (println "       phosphene <audio-file> --bench FRAMES [--size WxH] [--fx NAME]")
  (println "Without --fx, scenes change automatically every 32 beats (toggle with a).")
  (os/exit 2))

(defn- parse-args [args]
  (loop [xs args opts {}]
    (if-let [[a & more] (seq xs)]
      (case a
        "--fx"     (recur (rest more) (assoc opts :fx (first more)))
        "--scale"  (recur (rest more) (assoc opts :scale (parse-int (first more))))
        "--preset" (recur (rest more) (assoc opts :preset (parse-int (first more))))
        "--warm"   (recur (rest more) (assoc opts :warm (parse-double (first more))))
        "--mute"   (recur more (assoc opts :mute true))
        "--mic"    (if (and (seq more) (not (string/starts-with? (first more) "--")))
                     (recur (rest more) (assoc opts :mic (first more)))
                     (recur more (assoc opts :mic "default")))
        "--pcm"    (recur (rest more) (assoc opts :pcm (parse-int (first more))))
        "--no-post" (recur more (assoc opts :no-post true))
        "--fps"    (recur (rest more) (assoc opts :fps (parse-int (first more))))
        "--size"   (recur (rest more) (assoc opts :size (mapv parse-int (string/split (first more) "x"))))
        "--dump"   (recur (drop 2 more) (assoc opts :dump [(parse-double (first more)) (second more)]))
        "--bench"  (recur (rest more) (assoc opts :bench (parse-int (first more))))
        "--frames" (recur (drop 3 more) (assoc opts :frames [(parse-double (first more))
                                                            (parse-double (second more))
                                                            (nth more 2)]))
        (recur more (assoc opts :file a)))
      opts)))

(defn- screen-fb
  "A framebuffer for a cols×rows cell area at 1/scale resolution."
  [cols rows scale]
  (assoc (fb/make (max 8 (quot cols scale)) (max 8 (quot (* 2 rows) scale)))
         :cols cols :rows rows))

(defn- director [shape {:keys [fx preset no-post]}]
  (dir/make shape (if fx (dir/scene-index fx preset) (first dir/auto-order)) (nil? fx) (not no-post)))

;; ── Headless ─────────────────────────────────────────────────────────────

(defn- simulate
  "Runs the director at a fixed 30 fps from t0 to t1, logging scene changes;
  returns [director ms-per-frame]."
  [track d t0 t1]
  (let [ls (listen/make-state track t0) dt (/ 1.0 30)]
    (loop [t t0 d d n 0 ms 0]
      (if (< t t1)
        (let [a0 (now-ms)
              a  (listen/frame ls track t dt)
              d2 (dir/step d a)]
          (when (not= (dir/label d2) (dir/label d))
            (println (format "  %.2f s → %s" t (dir/label d2))))
          (recur (+ t dt) d2 (inc n) (+ ms (- (now-ms) a0))))
        [d (/ (double ms) (max 1 n))]))))

(defn- write-frames
  "Writes every frame from t0 for secs, at 30 fps, as OUT-DIR/NNNNN.ppm —
  one continuous run, so feedback trails carry across frames."
  [track d t0 secs dir]
  (mkdir dir)
  (let [ls (listen/make-state track t0) dt (/ 1.0 30) n (int (* secs 30))]
    (loop [k 0 d d]
      (when (< k n)
        (let [d (dir/step d (listen/frame ls track (+ t0 (* k dt)) dt))]
          (spit (format "%s/%05d.ppm" dir k) (fb/ppm (:shown d)))
          (recur (inc k) d))))
    (println "wrote" n "frames to" dir)))

(defn- headless [{:keys [file dump bench frames size scale warm] :as opts}]
  (let [[cols rows] (or size [160 48])
        track (audio/load file)
        shape (screen-fb cols rows (or scale 1))]
    (println (str "loaded " (basename file) ": " (format "%.1f" (:duration track)) " s, "
                  (count (filter pos? (seq (:onset track)))) " onsets"))
    (when dump
      (let [[t out] dump
            [d _] (simulate track (director shape opts) (max 0.0 (- t (or warm 3.0))) t)]
        (spit out (fb/ppm (:shown d)))
        (println "wrote" out "—" (dir/label d))))
    (when frames
      (let [[t0 secs out] frames
            w0 (max 0.0 (- t0 (or warm 3.0)))
            [d _] (simulate track (director shape opts) w0 t0)]
        (write-frames track d t0 secs out)))
    (when bench
      (let [t0 (min 30.0 (* 0.3 (:duration track)))
            [d ms] (simulate track (director shape opts) t0 (+ t0 (/ bench 30.0)))
            a0 (now-ms)
            _  (dotimes [_ 10] (fb/ansi (:shown d) cols rows 1))
            ams (/ (- (now-ms) a0) 10.0)]
        (println (format "%s %dx%d cells, %dx%d px: draw+listen %.1f ms/frame, ansi %.1f ms/frame"
                         (dir/label d) cols rows (:w shape) (:h shape) ms ams))))))

;; ── Live ─────────────────────────────────────────────────────────────────

(defn- start-player [file]
  (string/trim (:out (os/sh "sh" "-c" (str "afplay " (shq file) " >/dev/null 2>&1 & echo $!")))))

(defn- signal [pid sig] (when pid (os/sh "kill" (str "-" sig) pid)))

(defn- hud [cols row {:keys [name auto t dur fps a paused]}]
  (let [mm (fn [s] (format "%d:%02d" (int (quot s 60)) (int (mod s 60))))
        meter (fn [v] (let [n (max 0 (min 8 (int (* 4 v))))]
                        (str (apply str (repeat n "▮")) (apply str (repeat (- 8 n) "·")))))
        beat (if (> (:beat-env a) 0.5) (str ESC "[38;2;255;80;200m●") (str ESC "[38;2;70;60;90m○"))
        left (str " ◆ phosphene  " name (if auto "  ⟳" "") "  "
                  (if dur (str (mm t) "/" (mm dur)) (str (mm t) (if (:stalled a) "  no signal" "  live")))
                  (if paused "  ⏸" ""))
        right (str (if (:level a) (str "in " (meter (* 2 (:level a))) " ") "")
                   "bass " (meter (:bass-att a)) " mid " (meter (:mid-att a))
                   " treb " (meter (:treb-att a)) "  " (format "%2d fps " (int fps)))
        pad (max 1 (- cols (count left) (count right) 2))]
    (str ESC "[" row ";1H" ESC "[48;2;12;8;20m" ESC "[38;2;150;140;190m"
         left (apply str (repeat pad " ")) beat " " ESC "[38;2;150;140;190m" right
         ESC "[K" ESC "[0m")))

(defn- open-source
  "For --mic/--pcm: the live source and the ffmpeg pid to stop on exit."
  [{:keys [mic pcm]}]
  (let [port (or pcm (os/free-port))
        [pid log] (when mic (live/start-mic mic port))]
    (try
      [(live/connect port) pid]
      (catch e
        (signal pid "TERM")
        (println (str "\ncouldn't open " (if mic (str "mic " mic) (str "port " pcm))
                      (when (and log (file-exists? log)) (str ": " (string/trim (slurp log))))))
        (when mic (println "devices: ffmpeg -f avfoundation -list_devices true -i ''"))
        (os/exit 1)))))

(defn- live [{:keys [file fps scale mute] :as opts}]
  (let [size (term/size)]
    (when-not size (println "not a terminal; try --dump or --bench") (os/exit 1))
    (term/write (if file "decoding…" "listening…")) (term/flush)
    (let [track  (when file (audio/load file))
          [src mic-pid] (when-not file (open-source opts))
          [cols rows] size
          target (/ 1000.0 (or fps 30))
          right  (str ESC "[C") left (str ESC "[D")]
      (term/raw-mode!)
      (term/alternate-screen)
      (term/hide-cursor)
      (term/clear)
      (let [pid (when (and file (not mute)) (start-player file))]
        (try
          (loop [d (director (screen-fb cols (dec rows) (or scale 2)) opts)
                 ls (listen/make-state)
                 t0 (now-ms) paused-at nil
                 last (now-ms) fps-avg 30.0]
            (let [frame-start (now-ms)
                  t  (/ (- (or paused-at frame-start) t0) 1000.0)
                  dt (max 0.001 (/ (- frame-start last) 1000.0))
                  a  (if src
                       (listen/frame-live ls src t dt)
                       (listen/frame ls track t (if paused-at 0.001 dt)))
                  d  (if paused-at (or (and (:shown d) d) (dir/step d a)) (dir/step d a))
                  f  (:shown d)
                  [c r] (or (term/size) [cols rows])]
              (term/write (fb/ansi f (:cols f) (:rows f) 1))
              (term/write (hud c r {:name (dir/label d) :auto (:auto d) :t t
                                    :dur (:duration track) :fps fps-avg :a a :paused paused-at}))
              (term/flush)
              (let [k (when (term/key-pending?) (term/read-key))
                    resized (or (not= c (:cols f)) (not= (dec r) (:rows f)))]
                (cond
                  (or (= k "q") (= k (str (char 3))) (= k ESC)
                      (and track (> t (+ 0.5 (:duration track))))) nil
                  resized
                  (let [nd (dir/make (screen-fb c (dec r) (or scale 2)) (:i (:cur d)) (:auto d) (some? (:post d)))]
                    (term/clear)
                    (recur nd ls t0 paused-at frame-start fps-avg))
                  (= k right) (recur (dir/step-scene d 1) ls t0 paused-at frame-start fps-avg)
                  (= k left)  (recur (dir/step-scene d -1) ls t0 paused-at frame-start fps-avg)
                  (= k "a")   (recur (update d :auto not) ls t0 paused-at frame-start fps-avg)
                  (= k "b")   (recur (dir/toggle-post d :bloom) ls t0 paused-at frame-start fps-avg)
                  (= k "c")   (recur (dir/toggle-post d :cycle) ls t0 paused-at frame-start fps-avg)
                  (= k " ")
                  (if paused-at
                    (do (signal pid "CONT")
                        (recur d ls (+ t0 (- (now-ms) paused-at)) nil frame-start fps-avg))
                    (do (signal pid "STOP")
                        (recur d ls t0 (now-ms) frame-start fps-avg)))
                  :else
                  (let [spent (- (now-ms) frame-start)]
                    (when (< spent target) (sleep (int (- target spent))))
                    (recur d ls t0 paused-at frame-start
                           (+ (* 0.9 fps-avg) (* 0.1 (/ 1000.0 (max 1 (- (now-ms) frame-start)))))))))))
          (finally
            (signal pid "CONT")
            (signal pid "TERM")
            (when src (live/disconnect! src))
            (signal mic-pid "TERM")
            (term/show-cursor)
            (term/main-screen)
            (term/reset-style)
            (term/restore-mode!)))))))

(defn -main [& args]
  (let [opts (parse-args args)]
    (when-not (or (:file opts) (:mic opts) (:pcm opts)) (usage))
    (if (and (:file opts) (or (:dump opts) (:bench opts) (:frames opts)))
      (headless opts)
      (live opts))))

(apply -main *command-line-args*)
