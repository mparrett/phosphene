(ns phosphene.audio
  (:require [string] [math] [os]))

;; lg reads files as strings, but the string keeps the raw bytes: only walking
;; it as characters turns bytes above 0x7f into U+FFFD. `bytes` hands back the
;; originals, so ffmpeg's s16le is read directly.

(def SR 22050)

(defn- shq [s] (str "'" (string/replace s "'" "'\\''") "'"))

(defn- temp-path
  "Unique per run: concurrent decodes of the same file must not share it."
  [path]
  (str (os/temp-dir) "/phosphene-" (hash path) "-" (System/nanoTime) ".pcm"))

(defn- s16le->doubles!
  "Kernel: little-endian int16 pairs in b → samples in [-1, 1). lg's byte
  arrays read back unsigned today; the mask keeps this right if they ever
  follow Clojure's signed bytes."
  [^bytes b ^doubles out]
  (let [n (alength out)]
    (loop [i 0]
      (if (< i n)
        (let [j (* 2 i)
              v (+ (bit-and (aget b j) 0xff) (* 256 (bit-and (aget b (inc j)) 0xff)))]
          (aset out i (/ (double (if (> v 32767) (- v 65536) v)) 32768.0))
          (recur (inc i)))
        out))))

(defn decode
  "Decodes any ffmpeg-readable file to a mono double-array at SR."
  [path]
  (when-not (file-exists? path)
    (throw (ex-info (str "no such file: " path) {})))
  (let [out (temp-path path)
        res (os/sh "ffmpeg" "-nostdin" "-v" "error" "-i" path
                   "-ac" "1" "-ar" (str SR) "-f" "s16le" out)]
    (try
      (when-not (zero? (:exit res))
        (throw (ex-info (str "ffmpeg failed: " (:err res)) {})))
      (let [b (bytes (slurp out))]
        (s16le->doubles! b (double-array (quot (count b) 2))))
      (finally
        (when (file-exists? out) (delete-file out))))))

;; ── Pre-pass ─────────────────────────────────────────────────────────────
;; A full-track FFT is too slow on the VM (~6 ms per 1024 points), so the
;; pre-pass uses one-pole filters for bass energy and loudness per hop, which
;; is enough to find onsets ahead of time.

(def FPS-HOP 60)

(defn analyze [samples]
  (let [n     (alength samples)
        hop   (quot SR FPS-HOP)
        nf    (inc (quot n hop))
        rms   (double-array nf)
        bass  (double-array nf)
        onset (double-array nf)
        k     (- 1.0 (math/exp (/ (* -2.0 math/PI 150.0) SR)))]
    (loop [f 0 lp 0.0]
      (when (< f nf)
        (let [s0 (* f hop) s1 (min n (+ s0 hop))
              [lp sa sb]
              (loop [i s0 lp lp sa 0.0 sb 0.0]
                (if (< i s1)
                  (let [x (aget samples i) lp (+ lp (* k (- x lp)))]
                    (recur (inc i) lp (+ sa (* x x)) (+ sb (* lp lp))))
                  [lp sa sb]))
              m (double (max 1 (- s1 s0)))]
          (aset rms f (math/sqrt (/ sa m)))
          (aset bass f (math/sqrt (/ sb m)))
          (recur (inc f) lp))))
    ;; Onset: bass rises above 1.35× its trailing ~0.5 s mean, with a
    ;; refractory gap so one kick doesn't fire on consecutive hops.
    (loop [f 1 avg 0.0 last -100]
      (when (< f nf)
        (let [b    (aget bass f)
              flux (- b (aget bass (dec f)))
              hit? (and (> b (* 1.35 avg)) (pos? flux) (> b 0.02) (> (- f last) 12))]
          (when hit? (aset onset f 1.0))
          (recur (inc f) (+ avg (* 0.06 (- b avg))) (if hit? f last)))))
    {:samples samples :n n :hop hop :frames nf :rms rms :bass bass :onset onset
     :duration (/ (double n) SR)}))

(defn load [path] (analyze (decode path)))

(defn next-beat
  "Seconds from t until the next pre-detected onset, or nil within 2 s."
  [track t]
  (let [f0 (int (* t FPS-HOP)) on (:onset track) nf (:frames track)]
    (loop [f f0]
      (cond (or (>= f nf) (> (- f f0) (* 2 FPS-HOP))) nil
            (pos? (aget on f)) (/ (double (- f f0)) FPS-HOP)
            :else (recur (inc f))))))
