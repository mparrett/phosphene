(ns phosphene.fixtures
  "Generated test audio, so the tests carry no binary fixtures but the
  reference frame."
  (:require [os] [math] [phosphene.audio :as audio]))

(def KICK-PERIOD 0.5)

(defn- gen [name expr secs]
  (let [out (str (os/temp-dir) "/phosphene-test-" name ".wav")
        res (os/sh "ffmpeg" "-nostdin" "-v" "error" "-y" "-f" "lavfi"
                   "-i" (str "aevalsrc='" expr "':s=" audio/SR ":d=" secs)
                   "-c:a" "pcm_s16le" out)]
    (when-not (zero? (:exit res))
      (throw (ex-info (str "ffmpeg failed: " (:err res)) {})))
    out))

;; Every int16 value in order, so decoding can be checked exactly.
(defn ramp-wav [] (gen "ramp" "(mod(n,65536)-32768)/32768" 3))

;; A 55 Hz kick every KICK-PERIOD seconds.
(def ^:private kick
  (str "0.8*sin(2*PI*55*mod(t," KICK-PERIOD "))*exp(-12*mod(t," KICK-PERIOD "))"))

(defn kicks-wav [] (gen "kicks" kick 8))

;; A steady bass tone: loud, but nothing for onsets to fire on.
(defn tone-wav [] (gen "tone" "0.6*sin(2*PI*80*t)" 4))

(defn kick-sample
  "The same kick as kicks-wav, at sample index i."
  [i]
  (let [t (mod (/ (double i) audio/SR) KICK-PERIOD)]
    (* 0.8 (math/sin (* 2 math/PI 55 t)) (math/exp (* -12 t)))))
