(ns phosphene.live-test
  "Drives live/connect from an in-process PCM server, as --pcm would see it."
  (:require [clojure.test :refer [deftest is testing]] [math] [net]
            [phosphene.audio :as audio] [phosphene.live :as live]
            [phosphene.listen :as listen] [phosphene.fixtures :as fx]))

(defn- s16le
  "Little-endian int16 bytes for the samples xs."
  [xs]
  (let [b (byte-array (* 2 (count xs)))]
    (doseq [[i x] (map-indexed vector xs)]
      (let [v (int (math/round (* 32767.0 x)))]
        (aset b (* 2 i) (bit-and v 0xff))
        (aset b (inc (* 2 i)) (bit-and (bit-shift-right v 8) 0xff))))
    b))

(defn- write-chunked!
  "Writes b in chunks of chunk-size; an odd size makes samples straddle reads."
  [c b chunk-size]
  (let [n (alength b)]
    (loop [i 0]
      (when (< i n)
        (let [m (min chunk-size (- n i)) part (byte-array m)]
          (dotimes [k m] (aset part k (aget b (+ i k))))
          (net/write! c part)
          (sleep 2)
          (recur (+ i m)))))))

(defn- with-source
  "Runs (f src c) with src connected to a fresh server whose accepted
  connection c has already been sent b. Closes everything afterwards."
  [b f]
  (let [srv  (net/listen "127.0.0.1" 0)
        conn (future (let [c (net/accept srv)] (write-chunked! c b 4097) c))
        src  (live/connect (:port (net/local-address srv)) nil)
        c    @conn]
    (try (f src c)
         (finally
           (doseq [x [c srv]] (try (net/close! x) (catch e nil)))
           (live/disconnect! src)))))

(defn- wait-for [pred]
  (loop [i 0] (cond (pred) true (< i 300) (do (sleep 10) (recur (inc i))) :else false)))

(defn- head= [src n] #(= n @(:head src)))

(defn- tone [n hz amp]
  (map #(* amp (math/sin (/ (* 2 math/PI hz %) audio/SR))) (range n)))

(deftest samples-arrive-intact
  (let [xs (vec (tone audio/SR 100.0 0.3))]
    (with-source (s16le xs)
      (fn [src c]
        (is (wait-for (head= src (count xs))))
        (is (every? #(< (abs (- (aget (:ring src) %) (nth xs %))) (/ 1.0 32768))
                    (range (count xs)))
            "each sample within one LSB, across split reads")))))

(deftest lost-source-reads-as-silence
  (testing "closed"
    (with-source (s16le (tone audio/SR 100.0 0.3))
      (fn [src c]
        (net/close! c)
        (is (wait-for #(deref (:closed src))))
        (let [p (live/poll! src)]
          (is (:stalled p))
          (is (zero? (:level p)))
          (is (every? zero? (seq (:window p))))))))
  (testing "open but quiet past the stall timeout, then resuming"
    (with-source (s16le (tone audio/SR 100.0 0.3))
      (fn [src c]
        (is (wait-for (head= src audio/SR)))
        (let [p (live/poll! src)]
          (is (not (:stalled p)))
          (is (< 0.5 (:level p))))
        (sleep 1100)
        (let [p (live/poll! src)]
          (is (:stalled p))
          (is (zero? (:level p))))
        ;; Quieter than before, so a level carried over from the first
        ;; second would show as the wrong value.
        (let [more (quot audio/SR 5)]
          (net/write! c (s16le (tone more 100.0 0.15)))
          (is (wait-for (head= src (+ audio/SR more)))))
        (let [p (live/poll! src)]
          (is (not (:stalled p)))
          (is (< 0.25 (:level p) 0.75) "level tracks the new, quieter samples"))))))

(deftest digital-silence-is-no-signal
  ;; A denied mic sends zeros rather than failing.
  (with-source (s16le (repeat (* 2 audio/SR) 0.0))
    (fn [src c]
      (is (wait-for (head= src (* 2 audio/SR))))
      (sleep 1100)
      (is (:stalled (live/poll! src))))))

(deftest gain-is-capped
  ;; -80 dB stands in for room hiss. The peak releases over seconds, so
  ;; without the cap the gain would pass it partway through.
  (let [step (quot audio/SR 2)]
    (with-source (byte-array 0)
      (fn [src c]
        (dotimes [i 8]
          (net/write! c (s16le (tone step 100.0 1e-4)))
          (is (wait-for (head= src (* (inc i) step))))
          (live/poll! src))
        (is (= 30.0 (:gain @(:st src))) "gain sits at the cap")
        (is (< (:rms @(:st src)) 0.01) "hiss stays far below the 0.3 target")))))

(deftest streamed-kicks-trigger-beats
  ;; The first poll fires on any sound against the fresh onset state, so the
  ;; source settles on a steady tone before the kicks arrive.
  (let [n audio/SR]
    (with-source (s16le (tone n 80.0 0.1))
      (fn [src c]
        (is (wait-for (head= src n)))
        (live/poll! src)
        (net/write! c (s16le (tone n 80.0 0.1)))
        (is (wait-for (head= src (* 2 n))))
        (is (not (:beat? (live/poll! src))) "a steady tone is not a beat")
        (net/write! c (s16le (map fx/kick-sample (range n))))
        (is (wait-for (head= src (* 3 n))))
        (is (:beat? (live/poll! src)))))))

(deftest laptop-kicks-are-detected
  ;; Little bass and a quiet level; the auto-gain lifts what's left of the
  ;; kicks' attack enough for the bass band to see them.
  ;; The pad's own attack can fire in the first half second.
  (let [hits (filter #(>= % (quot audio/FPS-HOP 2)) (live/onsets (audio/decode (fx/laptop-kicks-wav))))
        want (map #(int (* % fx/KICK-PERIOD audio/FPS-HOP)) (range 1 16))]
    (is (= (count want) (count hits)))
    (is (every? true? (map #(<= (abs (- %1 %2)) 2) hits want)))))

(defn- stream-frames
  "Writes xs to c a quarter second at a time, running live/frame after each
  chunk arrives. Returns the frames."
  [src c st xs]
  (let [step (quot audio/SR 4)]
    (loop [xs xs out [] t 0.0]
      (if (seq xs)
        (let [chunk (take step xs) h0 @(:head src)]
          (net/write! c (s16le chunk))
          (is (wait-for (head= src (+ h0 (count chunk)))))
          (recur (drop step xs) (conj out (live/frame st src t 0.25)) (+ t 0.25)))
        out))))

(deftest noise-gate
  (testing "steady hiss goes dark and fires no beats"
    (with-source (byte-array 0)
      (fn [src c]
        (let [fs (stream-frames src c (listen/make-state) (fx/noise (* 6 audio/SR) 0.003))
              late (drop 12 fs)]
          (is (every? #(< (:level %) 0.05) late) "gated after ~3 s")
          (is (< (:gate @(:st src)) 0.05))
          (is (not-any? :beat late))))))
  (testing "a steady tone is not noise"
    (with-source (byte-array 0)
      (fn [src c]
        (let [fs (stream-frames src c (listen/make-state) (tone (* 4 audio/SR) 100.0 0.3))]
          (is (every? #(< 0.5 (:level %)) (drop 4 fs)))))))
  (testing "music over the hiss reopens it"
    (with-source (byte-array 0)
      (fn [src c]
        ;; Frames land a quarter second into each kick's decay, so the gate
        ;; itself is checked rather than the level.
        (let [st (listen/make-state)
              n (* 2 audio/SR)
              _ (stream-frames src c st (fx/noise (* 5 audio/SR) 0.003))
              closed (:gate @(:st src))
              fs (stream-frames src c st (map + (map fx/kick-sample (range n)) (fx/noise n 0.003)))]
          (is (< closed 0.05) "closed on the hiss first")
          (is (< 0.9 (:gate @(:st src))) "open again")
          (is (some :beat fs) "kicks register")))))
  (testing "a cough in the hiss doesn't hold it open"
    (with-source (byte-array 0)
      (fn [src c]
        (let [st (listen/make-state)
              cough (concat (fx/noise (quot audio/SR 10) 0.05) (fx/noise (* 2 audio/SR) 0.003))]
          (stream-frames src c st (fx/noise (* 5 audio/SR) 0.003))
          (stream-frames src c st cough)
          (is (< (:gate @(:st src)) 0.05))))))
  (testing "hats alone look flat but move, so they stay open"
    (with-source (byte-array 0)
      (fn [src c]
        (let [q (quot audio/SR 4) hit (quot audio/SR 30)
              hats (apply concat (repeat 24 (concat (fx/noise hit 0.3) (fx/noise (- q hit) 0.003))))]
          (stream-frames src c (listen/make-state) hats)
          (is (< 0.9 (:gate @(:st src))))))))
  (testing "reopening onto a steady tone fires no beat"
    ;; The fade-in must not read as a rise in level.
    (with-source (byte-array 0)
      (fn [src c]
        (let [st (listen/make-state)
              _ (stream-frames src c st (fx/noise (* 5 audio/SR) 0.003))
              fs (stream-frames src c st (tone (* 2 audio/SR) 80.0 0.3))]
          (is (< 0.9 (:gate @(:st src))) "open again")
          (is (not-any? :beat fs)))))))
